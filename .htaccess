RewriteEngine On

# Redirect root to frontend
RewriteRule ^$ frontend/ [R=301,L]

# Handle frontend directory requests
RewriteRule ^frontend/$ frontend/index.html [L]

# Handle existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)$ - [L]

# Handle API requests directly - don't redirect
RewriteRule ^backend/api/(.+\.php)$ backend/api/$1 [L]

# All other requests go through index.php
RewriteRule ^(.*)$ index.php [QSA,L]